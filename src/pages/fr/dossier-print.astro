---
import { getEntry } from 'astro:content';
import PrintLayout from '../../layouts/PrintLayout.astro';
import CvSections from '../../components/CvSections.astro';

// Full dossier: the same validated content and section component as /fr/.
const entry = await getEntry('cv', 'fr');
if (!entry) throw new Error('Missing CV content: src/content/cv/fr.yaml');
const { data } = entry;
---

<PrintLayout data={data} locale="fr" documentLabel="Dossier de compétences">
  <CvSections data={data} locale="fr" variant="web" />
</PrintLayout>
