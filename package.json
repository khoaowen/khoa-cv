{
  "name": "khoa-cv",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "check:content": "node scripts/check-content.mjs",
    "build": "astro check && astro build",
    "build:site": "node scripts/check-content.mjs && astro check && astro build",
    "check:rendered": "node scripts/check-rendered-cv.mjs",
    "pdf": "node scripts/gen-pdf.mjs",
    "build:all": "npm run build:site && npm run check:rendered && npm run pdf",
    "preview": "astro preview"
  },
  "dependencies": {
    "@astrojs/check": "0.9.9",
    "@astrojs/sitemap": "3.7.3",
    "astro": "7.1.3",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "pdf-lib": "1.17.1",
    "playwright": "1.62.0",
    "wrangler": "4.114.0"
  },
  "overrides": {
    "yaml-language-server": {
      "yaml": "2.8.3"
    }
  }
}
