{
  "name": "khoa-cv",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "check:content": "node scripts/check-content.mjs",
    "build": "astro check && astro build",
    "build:site": "node scripts/check-content.mjs && astro check && astro build && node scripts/assemble-release.mjs",
    "check:rendered": "node scripts/check-rendered-cv.mjs",
    "pdf": "node scripts/gen-pdf.mjs",
    "check:release": "node scripts/check-release.mjs",
    "test:release": "node scripts/test-release-privacy.mjs",
    "test:fixture": "node scripts/test-release-fixture.mjs",
    "build:all": "npm run build:site && npm run check:rendered && npm run pdf && npm run test:release && npm run test:fixture",
    "preview": "astro preview"
  },
  "dependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/sitemap": "3.7.4",
    "astro": "7.3.8",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "playwright": "1.64.0",
    "wrangler": "4.149.0"
  },
  "overrides": {
    "yaml-language-server": {
      "yaml": "2.8.3"
    }
  }
}
